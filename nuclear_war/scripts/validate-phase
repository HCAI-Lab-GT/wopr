#!/usr/bin/env python3

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parents[1]
SRC_PATH = PROJECT_ROOT / "src"
if str(SRC_PATH) not in sys.path:
    sys.path.insert(0, str(SRC_PATH))

from nuclear_war_env.constants import DEFAULT_LIMITS  # noqa: E402


def _python() -> str:
    return sys.executable or "python3"


def _iter_source_files(root: Path) -> list[Path]:
    return [
        path
        for path in root.rglob("*.py")
        if ".venv" not in path.parts and "__pycache__" not in path.parts
    ]


def check_line_limits(limit: int) -> None:
    over_limit: list[tuple[Path, int]] = []
    for path in _iter_source_files(Path("src")):
        lines = path.read_text(encoding="utf-8").splitlines()
        if len(lines) > limit:
            over_limit.append((path, len(lines)))
    if over_limit:
        for path, count in over_limit:
            print(f"Line limit exceeded: {path} ({count} > {limit})", file=sys.stderr)
        raise SystemExit(1)


def run_cmd(command: list[str]) -> None:
    result = subprocess.run(command, check=False)
    if result.returncode != 0:
        raise SystemExit(result.returncode)


def run_tests() -> None:
    run_cmd([_python(), "-m", "pytest"])


def run_lint() -> None:
    run_cmd([_python(), "-m", "ruff", "check", "src", "tests"])


def run_format_check() -> None:
    run_cmd([_python(), "-m", "ruff", "format", "--check", "src", "tests"])


def run_type_check() -> None:
    run_cmd([_python(), "-m", "pyright"])


def build_docs() -> None:
    run_cmd(
        [
            _python(),
            "-m",
            "pdoc",
            "--output-directory",
            str(DEFAULT_LIMITS.docs_output_dir),
            "nuclear_war_env",
        ]
    )


def main() -> None:
    parser = argparse.ArgumentParser(description="Validate Nuclear War v1 guardrails")
    parser.add_argument("--skip-docs", action="store_true")
    parser.add_argument("--skip-lint", action="store_true")
    parser.add_argument("--skip-format", action="store_true")
    parser.add_argument("--skip-types", action="store_true")
    args = parser.parse_args()

    check_line_limits(DEFAULT_LIMITS.max_file_lines)
    if not args.skip_lint:
        run_lint()
    if not args.skip_format:
        run_format_check()
    if not args.skip_types:
        run_type_check()
    run_tests()
    if not args.skip_docs:
        build_docs()


if __name__ == "__main__":
    main()
